{
  "industry": "半导体材料",
  "intro": "聚焦直接进入半导体制造流程的电子材料：晶圆制造材料八大赛道（硅片、光掩膜、光刻胶及配套、电子特气、湿电子化学品、CMP 抛光材料、溅射靶材、前驱体）与封装材料七大赛道；基础原料仅示意转换关系，不穷举公司。",
  "base_materials": [
    {
      "name": "电子级多晶硅",
      "relation": "高纯多晶硅经拉晶（直拉/区熔）→单晶硅棒→切磨抛→半导体硅片，是晶圆制造及后续封装的衬底起点",
      "note": "属晶圆制造材料环节，此处仅说明与封装材料的上下游关系"
    },
    {
      "name": "高纯石英砂",
      "relation": "高纯石英砂→电弧熔制/气炼→石英坩埚、石英管、石英舟等石英制品，用于拉晶与扩散等高温工艺",
      "note": "石英制品归装备零部件图谱，此处仅说明原料→材料转换关系"
    },
    {
      "name": "基础化工原料",
      "relation": "基础酸碱、溶剂、特种气体原料经提纯/合成→湿电子化学品（超净高纯试剂）、电子特气，用于清洗、刻蚀、沉积及封装工艺",
      "note": "湿电子化学品/电子特气另有专门赛道，此处仅说明关系"
    }
  ],
